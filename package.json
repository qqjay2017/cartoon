{
  "name": "cartoon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cartoon/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @cartoon/db db:migrate",
    "db:seed": "pnpm --filter @cartoon/db db:seed",
    "test": "pnpm --filter @cartoon/core test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "vite": "^7.3.5"
    }
  }
}
